# Dépendances
node_modules/
.pnpm-store/

# Configuration locale Convex : contient le lien vers le déploiement de
# développement de chaque poste. Jamais versionné.
.env.local
.env
.env.*
!.env.example

# Secrets : aucun secret ne doit entrer dans ce dépôt. Les valeurs sont posées
# côté Convex (`npx convex env set`), jamais dans un fichier du dépôt.
secrets/
*.pem
*.key

# Build et cache
dist/
build/
.cache/
coverage/
*.tsbuildinfo

# Éditeurs et OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
